{
  "name": "blob-avatar",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Make your own animated blob avatar. Export PNG, GIF or SVG, or embed it with one tag. Free, by Coleoni.",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 5320 --strictPort",
    "build": "vite-node scripts/pages.ts && vite build && vite build --config vite.embed.config.ts",
    "preview": "vite preview --port 5321",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "pages": "vite-node scripts/pages.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-node": "6.0.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tooltip": "1.2.16",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.43.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.6.0"
  }
}
